      "v": "Moonshot AI",
      "k": "Kimi Code"
     },
     {
      "n": "ZCode",
      "v": "Z.AI",
      "k": "ZCode"
     },
     {
      "n": "DeepSeek Harness",
      "v": {
       "de": "offen · Vorschau",
       "en": "open · preview"
      },
      "k": "DeepSeek Harness"
     },
     {
      "n": "Zed",

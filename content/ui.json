 "t012": {
  "de": "      <span class=\"o1\">KI-Agenten</span><br>",
  "en": "      <span class=\"o1\">AI agents,</span><br>"
 },
 "t013": {
  "de": "      <span class=\"o2\">verstehen<span class=\"dot\">.</span></span>",
  "en": "      <span class=\"o2\">understood<span class=\"dot\">.</span></span>"
 },
 "t014": {
  "de": "    <p class=\"lead rv\">Sieben Bausteine. Eine Schleife. Alles, was ein Sprachmodell braucht, um nicht nur zu reden, sondern zu <i>handeln</i>.</p>",
  "en": "    <p class=\"lead rv\">Seven building blocks. One loop. Everything a language model needs to not just talk, but to <i>act</i>.</p>"
 },
 "t015": {
  "de": "      <span class=\"pill\">Für <b>Einsteiger:innen</b></span>",
  "en": "      <span class=\"pill\">For <b>beginners</b></span>"
 },
 "t016": {
  "de": "      <span class=\"pill\">Stand <b>August 2026</b></span>",
  "en": "      <span class=\"pill\">As of <b>August 2026</b></span>"
 },
 "t017": {
  "de": "      <span class=\"pill\"><b>{{N:STECKBRIEF}}</b> Steckbriefe</span>",
  "en": "      <span class=\"pill\"><b>{{N:STECKBRIEF}}</b> fact-sheets</span>"
 },
 "t018": {
  "de": "  <div class=\"scroll-hint\"><span>Scrollen</span><span class=\"ln\"></span></div>",
  "en": "  <div class=\"scroll-hint\"><span>Scroll</span><span class=\"ln\"></span></div>"
 },
 "t019": {
  "de": "      <h2 class=\"rv\">Ein Chatbot <em>antwortet.</em><br>Ein Agent <em>handelt.</em></h2>",
  "en": "      <h2 class=\"rv\">A chatbot <em>answers.</em><br>An agent <em>acts.</em></h2>"
 },
 "t020": {
  "de": "      <div class=\"big rv\">Ein KI-Agent ist ein Sprachmodell <i>in einer Schleife</i>, das über <b>Werkzeuge</b> in der Welt etwas bewirkt.</div>",
  "en": "      <div class=\"big rv\">An AI agent is a language model <i>in a loop</i> that uses <b>tools</b> to affect the world.</div>"
 },
 "t021": {
  "de": "        <p class=\"body\">Das Modell <strong>denkt</strong>. Eine Steuerung dahinter, der <strong>Harness</strong>, hält die Schleife am Laufen, ruft Werkzeuge auf und füttert die Ergebnisse zurück ans Modell. Runde für Runde, bis die Aufgabe erledigt ist.</p>",
  "en": "        <p class=\"body\">The model <strong>thinks</strong>. A controller behind it, the <strong>harness</strong>, keeps the loop running, calls tools, and feeds the results back to the model. Round after round, until the task is done.</p>"
 },
 "t022": {
  "de": "          <div class=\"li\"><span class=\"n\">01</span><span class=\"t\"><b>Denken.</b> <span>Das Modell plant den nächsten Schritt.</span></span></div>",
  "en": "          <div class=\"li\"><span class=\"n\">01</span><span class=\"t\"><b>Think.</b> <span>The model plans the next step.</span></span></div>"
 },
 "t023": {
  "de": "          <div class=\"li\"><span class=\"n\">02</span><span class=\"t\"><b>Handeln.</b> <span>Der Harness ruft ein Werkzeug auf.</span></span></div>",
  "en": "          <div class=\"li\"><span class=\"n\">02</span><span class=\"t\"><b>Act.</b> <span>The harness calls a tool.</span></span></div>"
 },
 "t024": {
  "de": "          <div class=\"li\"><span class=\"n\">03</span><span class=\"t\"><b>Beobachten.</b> <span>Das Ergebnis fließt zurück.</span></span></div>",
  "en": "          <div class=\"li\"><span class=\"n\">03</span><span class=\"t\"><b>Observe.</b> <span>The result flows back.</span></span></div>"
 },
 "t025": {
  "de": "        <h2 class=\"rv\">Denken, handeln, <em>beobachten.</em></h2>",
  "en": "        <h2 class=\"rv\">Think, act, <em>observe.</em></h2>"
 },
 "t026": {
  "de": "        <p class=\"rv\">Der Kreislauf läuft, bis die Aufgabe erledigt ist, manchmal zwei Runden, manchmal zweihundert.</p>",
  "en": "        <p class=\"rv\">The loop runs until the task is done, sometimes two rounds, sometimes two hundred.</p>"
 },
 "t027": {
  "de": "        <h2 id=\"modstitel\">Sieben Bausteine, <em>ein Kreislauf.</em></h2>",
  "en": "        <h2 id=\"modstitel\">Seven building blocks, <em>one loop.</em></h2>"
 },
 "t028": {
  "de": "        <p>Jeder Agent besteht aus diesen Teilen. Tippe ein Modul an. Dahinter stehen die echten Werkzeuge und Modelle von August 2026.</p>",
  "en": "        <p>Every agent is built from these parts. Tap a module. Behind each one are the real tools and models as of August 2026.</p>"
 },

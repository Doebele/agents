     },
     {
      "n": "skills.sh",
      "v": {
       "de": "Marktplatz",
       "en": "Marketplace"
      },
      "k": "skills.sh"
     },
     {
      "n": "Impeccable",
      "v": {
       "de": "Design",
       "en": "design"
      },
      "k": "Impeccable"
     },
     {
      "n": "skill-creator",
      "v": {
       "de": "eigene bauen",
       "en": "build your own"
      },
      "k": "skill-creator"
     },
     {
      "n": {
       "de": "Unternehmens-Skills",
       "en": "Team skills"
      },
      "v": {
       "de": "eigenes Know-how",
       "en": "your own know-how"
      },
      "k": "eigene-skills"
     }
    ]
   }
  ],
  "insight": {
   "text": {
    "de": "<b>Faustregel:</b> Skills liefern Wissen, MCP liefert Zugriff.",
    "en": "<b>Rule of thumb:</b> skills deliver knowledge, MCP delivers access."
   },
   "warn": false
  }
 },
